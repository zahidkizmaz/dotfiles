#!/usr/bin/env zsh

# pretty print the python objects
# example: echo "{ 'a': 1, 'b': 2,     }" | pretty
# out: {'a': 1, 'b': 2}
function pretty() {
  python -c '__import__("pprint").pprint(eval(__import__("sys").stdin.read()))'
}

#--------------
# FZF Functions
#--------------
#------------------------------
# Checkout git branch (including remote branches), sorted by most recent commit
# remote branches are checked out as a new local branch if they don't exist
#------------------------------
function fco() {
  local branches branch
  branches=$(git for-each-ref --sort=-committerdate refs/ --format="%(refname:short)") \
    && branch=$(
      echo "$branches" \
        | fzf \
          --no-sort \
          --preview="git --no-pager branchdiff -150 '..{}'"
    ) \
    && git checkout $(echo "$branch" | sed "s/origin\///")
}

#--------------------------------
# Open a file with default editor
#--------------------------------
function vv() {
  local file
  file=$(
    eval "$FZF_DEFAULT_COMMAND" \
      | fzf --preview 'bat --color=always {} | head -$LINES'
  ) && $EDITOR $file
}

# Man without options will use fzf to select a page
function fzf-man() {
  MAN="/usr/bin/man"
  if [ -n "$1" ]; then
    $MAN "$@"
    return $?
  else
    $MAN -k . | fzf --reverse --preview="echo {1,2} | sed 's/ (/./' | sed -E 's/\)\s*$//' | xargs $MAN" | awk '{print $1 "." $2}' | tr -d '()' | xargs -r $MAN
    return $?
  fi
}

function fzf-aliases-functions() {
  CMD=$(
    (
      (alias)
      (functions | grep "()" | cut -d ' ' -f1 | grep -v "^_")
    ) | fzf | cut -d '=' -f1
  )

  eval $CMD
}

function fzf-cd-to-file() {
  local file
  local dir
  file=$(fzf +m -q "$1") && dir=$(dirname "$file") && cd "$dir"
  ls
}

function fzf-env-vars() {
  local out
  out=$(env | fzf)
  echo $(echo $out | cut -d= -f2)
}

function fzf-kill-processes() {
  local pid
  pid=$(ps -ef | sed 1d | fzf -m | awk '{print $2}')

  if [ "x$pid" != "x" ]; then
    echo $pid | xargs kill -${1:-9}
  fi
}

#------------------------------
# GitHub CLI Functions
#------------------------------
function prc() {
  local cmd
  local pr_template
  local gh_pr_create
  gh_pr_create='gh pr create --draft --assignee "@me"'

  pr_template="$(git ls-files | grep -i -o -F "pull_request_template.md" | head -n 1)"
  if [ ! -z "${pr_template}" ] && [ "${pr_template}" != "" ]; then
    cmd="$gh_pr_create --template $pr_template"
  else
    cmd="$gh_pr_create --fill"
  fi

  eval "$cmd" && gh pr view --web
}

#------------------------------
# Sesh
#------------------------------
function sessions() {
  sesh connect "$(
    sesh list --icons | fzf-tmux -p 80%,70% \
      --no-sort --ansi --border-label ' sesh ' --prompt '⚡ ' \
      --bind 'tab:down,btab:up' \
      --preview-window 'right:55%' \
      --preview 'sesh preview {}'
  )"
}
alias sl='sessions'

#------------------------------
# Run Pi with only $PWD and ~/.pi writable. Everything else is read-only or virtual.
function pibox() {
  local cwd system_path locale_archive
  cwd=$(pwd -P)
  system_path="$(readlink -f /run/current-system)/sw/bin"
  locale_archive="$(readlink -f "${LOCALE_ARCHIVE:-/run/current-system/sw/lib/locale/locale-archive}")"

  # refuse dirs that would expose more than project cwd
  if [ "$cwd" = "$HOME" ] || [ "${HOME#"$cwd"/}" != "$HOME" ]; then
    echo "Refusing: $cwd would expose $HOME" >&2
    return 1
  fi

  case "$cwd" in
    "$HOME/.ssh" | "$HOME/.ssh/"* | \
      "$HOME/.gnupg" | "$HOME/.gnupg/"* | \
      "$HOME/.aws" | "$HOME/.aws/"* | \
      "$HOME/.config" | "$HOME/.config/"*)
      echo "Refusing sensitive dir: $cwd" >&2
      return 1
      ;;
  esac

  # ~/.pi and ~/.config/mcp hold stow symlinks (settings.json, AGENTS.md,
  # mcp.json) whose targets live outside the sandbox. bwrap cannot mount a file
  # over a symlink, so bind the resolved target directory instead. Ancestors are
  # created top-down so the relative symlinks resolve without naming the
  # dotfiles repo here.
  local settings_real pi_dir mcp_real d
  local -a stow_dirs bwrap_args
  stow_dirs=()
  settings_real=$(readlink -f "$HOME/.pi/agent/settings.json" 2>/dev/null)
  if [ -n "$settings_real" ]; then
    pi_dir=${settings_real:h}
    d=$pi_dir
    while [ -n "$d" ] && [ "$d" != "$HOME" ] && [ "$d" != "/" ]; do
      stow_dirs=("$d" "${stow_dirs[@]}")
      d=${d:h}
    done
  fi
  mcp_real=$(readlink -f "$HOME/.config/mcp/mcp.json" 2>/dev/null)

  bwrap_args=(
    --die-with-parent
    --new-session
    --unshare-all
    --share-net
    --clearenv
    --cap-drop ALL
    --ro-bind /nix/store /nix/store
    --dir /etc
    --ro-bind /etc/resolv.conf /etc/resolv.conf
    --ro-bind /etc/passwd /etc/passwd
    --ro-bind /etc/group /etc/group
    --ro-bind /etc/static/nsswitch.conf /etc/nsswitch.conf
    --ro-bind /etc/static/hosts /etc/hosts
    --ro-bind /etc/static/ssl /etc/ssl
    --dir /bin
    --ro-bind /bin/sh /bin/sh
    --dir /usr/bin
    --ro-bind /usr/bin/env /usr/bin/env
    --dev /dev
    --proc /proc
    --tmpfs /tmp
    --dir "$HOME"
    --bind "$HOME/.pi" "$HOME/.pi"
    --dir "$HOME/.config"
  )
  for d in "${stow_dirs[@]}"; do
    bwrap_args+=(--dir "$d")
  done
  if [ -n "$pi_dir" ]; then
    bwrap_args+=(--ro-bind "$pi_dir" "$pi_dir")
  fi
  if [ -n "$mcp_real" ]; then
    bwrap_args+=(--ro-bind "${mcp_real:h}" "$HOME/.config/mcp")
  fi
  bwrap_args+=(
    --bind "$cwd" "$cwd"
    --chdir "$cwd"
    --setenv HOME "$HOME"
    --setenv USER "$USER"
    --setenv LOGNAME "$USER"
    --setenv SHELL "$system_path/bash"
    --setenv PATH "$system_path:/usr/bin:/bin"
    --setenv TERM "${TERM:-xterm-256color}"
    --setenv COLORTERM "${COLORTERM:-truecolor}"
    --setenv LANG "${LANG:-C.UTF-8}"
    --setenv LC_ALL "${LC_ALL:-C.UTF-8}"
    --setenv LOCALE_ARCHIVE "$locale_archive"
    --setenv XDG_RUNTIME_DIR /tmp
    --setenv TMPDIR /tmp
    --setenv GRAFANA_SERVICE_ACCOUNT_TOKEN "${GRAFANA_SERVICE_ACCOUNT_TOKEN:-}"
    --setenv HOME_ASSISTANT_TOKEN "${HOME_ASSISTANT_TOKEN:-}"
    pi "$@"
  )

  nix run nixpkgs#bubblewrap -- "${bwrap_args[@]}"
}
