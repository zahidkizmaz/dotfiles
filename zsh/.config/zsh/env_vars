#!/usr/bin/env bash

#---------
# ZSH Vars
#---------
export EDITOR='nvim'
export PSQL_EDITOR='nvim'
export VISUAL='nvim'
export PAGER='less'
export LESS='-R'
export MANPAGER='nvim +Man!'
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
export PATH="$HOME/.local/bin:$PATH"

#--------
# FD Vars
#--------
export FD_OPTIONS="--hidden -I --follow --exclude .git --exclude node_modules --exclude .direnv"

#---------
# FZF Vars
#---------
export FZF_DEFAULT_COMMAND="fd --type f --type l $FD_OPTIONS"
export FZF_DEFAULT_OPTS="--no-hscroll --height 40% --layout=reverse --margin=0 --info=inline --color=bg+:#302D41,bg:#1E1E2E,spinner:#F8BD96,hl:#F28FAD --color=fg:#D9E0EE,header:#F28FAD,info:#DDB6F2,pointer:#F8BD96 --color=marker:#F8BD96,fg+:#F2CDCD,prompt:#DDB6F2,hl+:#F28FAD"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range :50 {}'"

#---------
# BAT Vars
#---------
export BAT_THEME="Catppuccin-mocha"

#------------
# Pip Setting
#------------
export PIP_REQUIRE_VIRTUALENV=true

#-----------------------------
# Term Setting Works With Tmux
#-----------------------------
export TERM=xterm-256color

#--------------------------
# MCP server tokens
# Loaded from agenix secrets where present; absent on hosts
# without the keys, and opencode handles unset as empty string.
#--------------------------
export HOME_ASSISTANT_TOKEN="$(cat /run/agenix/hass-mcp-key 2>/dev/null)"
export GRAFANA_SERVICE_ACCOUNT_TOKEN="$(cat /run/agenix/grafana-sa-token 2>/dev/null)"
