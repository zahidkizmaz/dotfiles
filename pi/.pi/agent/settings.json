{
  "lastChangelogVersion": "1.3.0",
  "defaultProvider": "openrouter",
  "defaultModel": "deepseek/deepseek-v4.1-flash",
  "defaultThinkingLevel": "low",
  "enableInstallTelemetry": false,
  "theme": "dark",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:pi-vim"
  ],
  "extensions": [
    "-builtin:mcp"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 12000
  }
}
